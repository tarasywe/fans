# Copy to .env.local (git-ignored) and restart Metro with `npx expo start --clear`.
# Backend origin WITHOUT /v1. Leave unset to use the in-app mock API.
# Railway:   EXPO_PUBLIC_API_URL=https://wikibackend-production-953e.up.railway.app
# Local Nest (phone on the same Wi-Fi): EXPO_PUBLIC_API_URL=http://192.168.0.10:3000
EXPO_PUBLIC_API_URL=

# 1 = use the in-app mock API even when EXPO_PUBLIC_API_URL is set (npm run start:mock* sets it).
# EXPO_PUBLIC_USE_MOCK_API=1

# RevenueCat public SDK key. A `test_…` key uses the RevenueCat Test Store (simulated billing, no
# real charges). Unset → the app uses its built-in simulated store.
EXPO_PUBLIC_REVENUECAT_API_KEY=
