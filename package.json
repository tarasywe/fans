{
  "name": "voicegram",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check . && tsc --noEmit",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "start:mock": "EXPO_PUBLIC_USE_MOCK_API=1 expo start --clear",
    "start:mock:clean": "EXPO_PUBLIC_USE_MOCK_API=1 EXPO_PUBLIC_MOCK_RUN_ID=$(date +%s) EXPO_PUBLIC_MOCK_SCENARIO=clean expo start --clear",
    "start:mock:offline": "EXPO_PUBLIC_USE_MOCK_API=1 EXPO_PUBLIC_MOCK_RUN_ID=$(date +%s) EXPO_PUBLIC_MOCK_SCENARIO=offline expo start --clear",
    "start:mock:lost-response": "EXPO_PUBLIC_USE_MOCK_API=1 EXPO_PUBLIC_MOCK_RUN_ID=$(date +%s) EXPO_PUBLIC_MOCK_SCENARIO=lost-response expo start --clear",
    "start:mock:server-error": "EXPO_PUBLIC_USE_MOCK_API=1 EXPO_PUBLIC_MOCK_RUN_ID=$(date +%s) EXPO_PUBLIC_MOCK_SCENARIO=server-error expo start --clear",
    "test:reliability": "jest src/features/chats/__tests__/reliability src/features/chats/__tests__/outbox-store.test.ts src/features/chats/__tests__/send-error.test.ts --verbose",
    "start:mock:billing-slow-confirm": "EXPO_PUBLIC_USE_MOCK_API=1 EXPO_PUBLIC_MOCK_RUN_ID=$(date +%s) EXPO_PUBLIC_MOCK_SCENARIO=billing-slow-confirm expo start --clear",
    "start:mock:billing-no-confirm": "EXPO_PUBLIC_USE_MOCK_API=1 EXPO_PUBLIC_MOCK_RUN_ID=$(date +%s) EXPO_PUBLIC_MOCK_SCENARIO=billing-no-confirm expo start --clear",
    "start:mock:billing-store-fails": "EXPO_PUBLIC_USE_MOCK_API=1 EXPO_PUBLIC_MOCK_RUN_ID=$(date +%s) EXPO_PUBLIC_MOCK_SCENARIO=billing-store-fails expo start --clear",
    "test:billing": "jest src/features/billing --verbose"
  },
  "dependencies": {
    "@expo/html-elements": "0.12.5",
    "@gluestack-ui/core": "5.0.15",
    "@gluestack-ui/utils": "5.0.6",
    "@legendapp/list": "3.4.0",
    "@legendapp/motion": "2.5.3",
    "@react-native-community/netinfo": "12.0.1",
