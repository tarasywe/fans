    "expo-keep-awake": "57.0.0",
    "expo-glass-effect": "57.0.0",
    "expo-symbols": "57.0.0",
    "@expo/cli": "57.0.6",
    "@expo/router-server": "57.0.2",
    "@expo/metro-runtime": "57.0.3",
    "@expo/prebuild-config": "57.0.5",
    "expo-server": "57.0.0"
  }
